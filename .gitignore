# Python artifacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# Build outputs
build/
dist/
*.egg-info/
.coverage
.pytest_cache/
.mypy_cache/
htmlcov/

# Editor/OS noise
.DS_Store
.idea/
.vscode/

.venv/

# Secrets & credentials (defensive)
.env
.env.*
*.pem
*.key
*.cert
*.p12
secrets.yaml
credentials.json

# Large backups
backups/
*.bundle

# Node
node_modules/

# Test artifacts
test-results/
coverage.json
coverage.xml

# Logs
*.log

# Generated add-on packaging shadow tree, canonical Core truth lives in addons/pilotsuite/app/
addons/pilotsuite/rootfs/usr/src/app/**
!addons/pilotsuite/rootfs/usr/src/app/main.py
!addons/pilotsuite/rootfs/usr/src/app/requirements.txt

# Dev artifacts
.last-dev-check

# Virtual environments
qg_venv/
*.zip
