{
  "domain": "pilotsuite",
  "name": "PilotSuite Core",
  "version": "15.4.10",
  "config_flow": true,
  "documentation": "https://github.com/GreenhillEfka/pilotsuite-styx-ha/blob/main/README.md",
  "requirements": [
    "aiohttp>=3.9.0",
    "numpy>=1.24.0",
    "scikit-learn>=1.3.0",
    "onnxruntime>=1.16.0",
    "faiss-cpu>=1.7.4",
    "sentence-transformers>=2.2.0",
    "ollama>=0.1.0",
    "ortools>=9.8.0",
    "fastapi>=0.104.0",
    "websockets>=12.0"
  ],
  "codeowners": ["@GreenhillEfka"],
  "iot_class": "local_polling",
  "loggers": ["pilotsuite"],
  "dependencies": ["http", "persistent_notification"],
  "after_dependencies": ["recorder", "history"],
  "quality_scale": "platinum",
  "integration_type": "hub"
}
