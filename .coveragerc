[run]
source = .
omit =
    */tests/*
    */test_*
    */rootfs/*
    */examples/*
    */scripts/*
    venv/*
    .git/*
    node_modules/*

[report]
precision = 2
show_missing = True
skip_covered = False
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
    class.*Protocol

[html]
directory = htmlcov
