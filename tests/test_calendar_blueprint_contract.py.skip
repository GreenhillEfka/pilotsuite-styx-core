"""Regression coverage for calendar blueprint optional-dependency behavior."""

from __future__ import annotations

from pathlib import Path
import sys

from flask import Flask


REPO_ROOT = Path(__file__).resolve().parents[1]
CORE_APP_ROOT = REPO_ROOT / "copilot_core" / "rootfs" / "usr" / "src" / "app"

path_str = str(CORE_APP_ROOT)
if CORE_APP_ROOT.exists() and path_str not in sys.path:
    sys.path.insert(0, path_str)


from copilot_core.api.v1 import calendar as calendar_module  # noqa: E402
from copilot_core.api.v1.calendar import calendar_bp  # noqa: E402


def _client(monkeypatch):
    monkeypatch.setenv("COPILOT_AUTH_TOKEN", "test-token")
    monkeypatch.setattr(calendar_module, "http_requests", None)

    app = Flask(__name__)
    app.register_blueprint(calendar_bp)
    return app.test_client()


def test_calendar_blueprint_degrades_cleanly_without_requests(monkeypatch) -> None:
    client = _client(monkeypatch)
    headers = {"Authorization": "Bearer test-token"}

    for path in (
        "/api/v1/calendar",
        "/api/v1/calendar/events/today",
        "/api/v1/calendar/events/upcoming?days=3",
    ):
        response = client.get(path, headers=headers)
        assert response.status_code == 503
        assert response.get_json()["error"] == "calendar_unavailable"


def test_calendar_context_endpoint_works(monkeypatch) -> None:
    """Test that the /context endpoint returns valid JSON."""
    client = _client(monkeypatch)
    headers = {"Authorization": "Bearer test-token"}
    
    response = client.get("/api/v1/calendar/context", headers=headers)
    assert response.status_code in (200, 503)
    data = response.get_json()
    assert "context" in data or "error" in data
